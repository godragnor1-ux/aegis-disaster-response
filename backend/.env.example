# ==========================================
# AEGIS-PULSE (ResQ-Command) Backend Env Config
# ==========================================

# Server Port (Render sets this automatically to 10000 or defaults to 5001)
PORT=5001
NODE_ENV=production

# MongoDB Atlas Connection String (Supports either MONGO_URI or MONGODB_URI)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resq-command?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:secure_password@cluster0.aegis.mongodb.net/resq-command?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:secure_password@cluster0.aegis.mongodb.net/resq-command?retryWrites=true&w=majority

# JWT Secret Key for RBAC Authentication (Generate with: openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_replace_in_production_2026

# Allowed Frontend Client Origin(s) on Vercel (comma-separated if multiple)
# Example: https://resq-command.vercel.app,http://localhost:3000
CLIENT_ORIGIN=https://resq-command.vercel.app,http://localhost:3000
