# ==========================================
# AEGIS-PULSE (ResQ-Command) Frontend Env Config
# ==========================================

# Backend REST API URL on Render (Supported via NEXT_PUBLIC_API_URL or NEXT_PUBLIC_SERVER_URL)
# Example: https://resq-command-backend.onrender.com
NEXT_PUBLIC_API_URL=https://resq-command-backend.onrender.com
NEXT_PUBLIC_SERVER_URL=https://resq-command-backend.onrender.com

# Backend WebSocket URL on Render
# Example: https://resq-command-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://resq-command-backend.onrender.com

# Optional: Mapbox Public Access Token (If using Mapbox GL satellite layers)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiYWVnaXMtdGFjdGljYWwiLCJhIjoiY2x6MG14NGx5MDJmbjJxc21iMGJ0Y3B3biJ9.sample_token_replace
