# --- BACKEND (Render) ---
PORT=5001
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resq-command?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resq-command?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_replace_in_production_2026
CLIENT_ORIGIN=https://resq-command.vercel.app,http://localhost:3000

# --- FRONTEND (Vercel) ---
NEXT_PUBLIC_API_URL=https://resq-command-backend.onrender.com
NEXT_PUBLIC_SERVER_URL=https://resq-command-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://resq-command-backend.onrender.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.sample_mapbox_token
